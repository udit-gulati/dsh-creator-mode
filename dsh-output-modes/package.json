{
  "name": "dsh-output-modes",
  "version": "0.0.1",
  "description": "Choose how DeepSeek Harness presents a reply: detailed prose, a short answer, structured JSON, a runnable React app, or a user-defined output contract with validation and preview.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "src",
    "scripts"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "output",
    "composer"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "scripts": {
    "build": "node scripts/build-client.mjs"
  }
}
